## GENERIC SECTION
autodock_parameter_version 4.2       # used by autodock to validate parameter set
outlev ADT                           # diagnostic output level
smooth 0

## LIGAND-SPECIFIC SECTION
ligand_types A C H HD N NA OA SA Cl F S Br P I             # ligand atom types
fld 2ya6_pocket.maps.fld  # grid_data_file
map 2ya6_pocket.A.map # atom-specific affinity map
map 2ya6_pocket.C.map # atom-specific affinity map
map 2ya6_pocket.H.map # atom-specific affinity map
map 2ya6_pocket.HD.map # atom-specific affinity map
map 2ya6_pocket.N.map # atom-specific affinity map
map 2ya6_pocket.NA.map # atom-specific affinity map
map 2ya6_pocket.OA.map # atom-specific affinity map
map 2ya6_pocket.SA.map # atom-specific affinity map
map 2ya6_pocket.Cl.map # atom-specific affinity map
map 2ya6_pocket.F.map # atom-specific affinity map
map 2ya6_pocket.S.map # atom-specific affinity map
map 2ya6_pocket.Br.map # atom-specific affinity map
map 2ya6_pocket.P.map # atom-specific affinity map
map 2ya6_pocket.I.map # atom-specific affinity map
elecmap 2ya6_pocket.e.map # electrostatic potential map
dsolvmap 2ya6_pocket.d.map              # desolvation potential map
move 2ya6_ligand.pdbqt
## EVALUATE LIGAND ENERGY in RECEPTOR SECTION
epdb                                 # small molecule to be evaluated

## AUTODOCK_SCORE -6.04
