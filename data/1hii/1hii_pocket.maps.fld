# AVS field file
#
# AutoDock Atomic Affinity and Electrostatic Grids
#
# Created by ./autogrid4.
#
#SPACING 0.500
#NELEMENTS 90 92 96
#CENTER 16.000 31.000 11.500
#MACROMOLECULE 1hii_pocket.pdbqt
#GRID_PARAMETER_FILE 1hii_pocket.gpf
#
ndim=3			# number of dimensions in the field
dim1=91			# number of x-elements
dim2=93			# number of y-elements
dim3=97			# number of z-elements
nspace=3		# number of physical coordinates per point
veclen=16		# number of affinity values at each point
data=float		# data type (byte, integer, float, double)
field=uniform		# field type (uniform, rectilinear, irregular)
coord 1 file=1hii_pocket.maps.xyz filetype=ascii offset=0
coord 2 file=1hii_pocket.maps.xyz filetype=ascii offset=2
coord 3 file=1hii_pocket.maps.xyz filetype=ascii offset=4
label=A-affinity	# component label for variable 1
label=C-affinity	# component label for variable 2
label=H-affinity	# component label for variable 3
label=HD-affinity	# component label for variable 4
label=N-affinity	# component label for variable 5
label=NA-affinity	# component label for variable 6
label=OA-affinity	# component label for variable 7
label=SA-affinity	# component label for variable 8
label=Cl-affinity	# component label for variable 9
label=F-affinity	# component label for variable 10
label=S-affinity	# component label for variable 11
label=Br-affinity	# component label for variable 12
label=P-affinity	# component label for variable 13
label=I-affinity	# component label for variable 14
label=Electrostatics	# component label for variable 14
label=Desolvation	# component label for variable 15
#
# location of affinity grid files and how to read them
#
variable 1 file=1hii_pocket.A.map filetype=ascii skip=6
variable 2 file=1hii_pocket.C.map filetype=ascii skip=6
variable 3 file=1hii_pocket.H.map filetype=ascii skip=6
variable 4 file=1hii_pocket.HD.map filetype=ascii skip=6
variable 5 file=1hii_pocket.N.map filetype=ascii skip=6
variable 6 file=1hii_pocket.NA.map filetype=ascii skip=6
variable 7 file=1hii_pocket.OA.map filetype=ascii skip=6
variable 8 file=1hii_pocket.SA.map filetype=ascii skip=6
variable 9 file=1hii_pocket.Cl.map filetype=ascii skip=6
variable 10 file=1hii_pocket.F.map filetype=ascii skip=6
variable 11 file=1hii_pocket.S.map filetype=ascii skip=6
variable 12 file=1hii_pocket.Br.map filetype=ascii skip=6
variable 13 file=1hii_pocket.P.map filetype=ascii skip=6
variable 14 file=1hii_pocket.I.map filetype=ascii skip=6
variable 15 file=1hii_pocket.e.map filetype=ascii skip=6
variable 16 file=1hii_pocket.d.map filetype=ascii skip=6
