npts 81 92 90# num.grid points in xyz
gridfld 5uez_pocket.maps.fld # grid_data_file
spacing 0.5                        # spacing(A)
receptor_types A C NA OA N S HD      # receptor atom types
ligand_types A C H HD N NA OA SA Cl F S Br P I             # ligand atom types
receptor 5uez_pocket.pdbqt # macromolecule
gridcenter 13 9.5 0                    # xyz-coordinates or auto
smooth 0.5                           # store minimum energy w/in rad(A)
map 5uez_pocket.A.map # atom-specific affinity map
map 5uez_pocket.C.map # atom-specific affinity map
map 5uez_pocket.H.map # atom-specific affinity map
map 5uez_pocket.HD.map # atom-specific affinity map
map 5uez_pocket.N.map # atom-specific affinity map
map 5uez_pocket.NA.map # atom-specific affinity map 
map 5uez_pocket.OA.map # atom-specific affinity map
map 5uez_pocket.SA.map # atom-specific affinity ma 
map 5uez_pocket.Cl.map # atom-specific affinity map
map 5uez_pocket.F.map # atom-specific affinity map
map 5uez_pocket.S.map # atom-specific affinity map
map 5uez_pocket.Br.map # atom-specific affinity map
map 5uez_pocket.P.map # atom-specific affinity map
map 5uez_pocket.I.map # atom-specific affinity map
elecmap 5uez_pocket.e.map # electrostatic potential map
dsolvmap 5uez_pocket.d.map              # desolvation potential map
dielectric -0.1465                   # <0, AD4 distance-dep.diel;>0, constant
