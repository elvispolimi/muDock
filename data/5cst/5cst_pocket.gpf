npts 90 84 84# num.grid points in xyz
gridfld /home/gaccordi/repo/muDock/data/5cst/5cst_pocket.maps.fld # grid_data_file
spacing 0.5                        # spacing(A)
receptor_types A C NA OA N S HD      # receptor atom types
ligand_types A C H HD N NA OA SA Cl F S Br P I             # ligand atom types
receptor /home/gaccordi/repo/muDock/data/5cst/5cst_pocket.pdbqt # macromolecule
gridcenter -15.5 -14 4                    # xyz-coordinates or auto
smooth 0.5                           # store minimum energy w/in rad(A)
