npts 80 88 90# num.grid points in xyz
gridfld 4few_pocket.maps.fld # grid_data_file
spacing 0.5                        # spacing(A)
receptor_types A C NA OA N S HD      # receptor atom types
ligand_types A C H HD N NA OA SA Cl F S Br P I             # ligand atom types
receptor 4few_pocket.pdbqt # macromolecule
gridcenter -20.5 -28 -17.5                    # xyz-coordinates or auto
smooth 0.5                           # store minimum energy w/in rad(A)
map 4few_pocket.A.map # atom-specific affinity map
map 4few_pocket.C.map # atom-specific affinity map
map 4few_pocket.H.map # atom-specific affinity map
map 4few_pocket.HD.map # atom-specific affinity map
map 4few_pocket.N.map # atom-specific affinity map
map 4few_pocket.NA.map # atom-specific affinity map
map 4few_pocket.OA.map # atom-specific affinity map
map 4few_pocket.SA.map # atom-specific affinity map
map 4few_pocket.Cl.map # atom-specific affinity map
map 4few_pocket.F.map # atom-specific affinity map
map 4few_pocket.S.map # atom-specific affinity map
map 4few_pocket.Br.map # atom-specific affinity map
map 4few_pocket.P.map # atom-specific affinity map
map 4few_pocket.I.map # atom-specific affinity map
elecmap 4few_pocket.e.map # electrostatic potential map
dsolvmap 4few_pocket.d.map              # desolvation potential map
dielectric -0.1465                   # <0, AD4 distance-dep.diel;>0, constant
