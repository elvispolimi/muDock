## GENERIC SECTION
autodock_parameter_version 4.2       # used by autodock to validate parameter set
outlev ADT                           # diagnostic output level

## LIGAND-SPECIFIC SECTION
ligand_types C H HD N OA           # atoms types in ligand
fld /home/gaccordi/dataset/test_dataset/1fkb/1fkb_pocket.maps.fld  # grid_data_file
map /home/gaccordi/dataset/test_dataset/1fkb/1fkb_pocket.H.map     # atom-specific affinity map
map /home/gaccordi/dataset/test_dataset/1fkb/1fkb_pocket.C.map     # atom-specific affinity map
map /home/gaccordi/dataset/test_dataset/1fkb/1fkb_pocket.HD.map    # atom-specific affinity map
map /home/gaccordi/dataset/test_dataset/1fkb/1fkb_pocket.N.map     # atom-specific affinity map
map /home/gaccordi/dataset/test_dataset/1fkb/1fkb_pocket.OA.map    # atom-specific affinity map
elecmap /home/gaccordi/dataset/test_dataset/1fkb/1fkb_pocket.e.map # electrostatics map
desolvmap /home/gaccordi/dataset/test_dataset/1fkb/1fkb_pocket.d.map # desolvation map
move /home/gaccordi/dataset/test_dataset/1fkb/1fkb_ligand.pdbqt                 # small molecule

## EVALUATE LIGAND ENERGY in RECEPTOR SECTION
epdb                                 # small molecule to be evaluated
