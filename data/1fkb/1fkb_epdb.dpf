## GENERIC SECTION
autodock_parameter_version 4.2       # used by autodock to validate parameter set
outlev ADT                           # diagnostic output level
smooth 0

## LIGAND-SPECIFIC SECTION
ligand_types A C H HD N NA OA SA Cl F S Br P I             # ligand atom types
fld 1fkb_pocket.maps.fld  # grid_data_file
map 1fkb_pocket.A.map # atom-specific affinity map
map 1fkb_pocket.C.map # atom-specific affinity map
map 1fkb_pocket.H.map # atom-specific affinity map
map 1fkb_pocket.HD.map # atom-specific affinity map
map 1fkb_pocket.N.map # atom-specific affinity map
map 1fkb_pocket.NA.map # atom-specific affinity map
map 1fkb_pocket.OA.map # atom-specific affinity map
map 1fkb_pocket.SA.map # atom-specific affinity map
map 1fkb_pocket.Cl.map # atom-specific affinity map
map 1fkb_pocket.F.map # atom-specific affinity map
map 1fkb_pocket.S.map # atom-specific affinity map
map 1fkb_pocket.Br.map # atom-specific affinity map
map 1fkb_pocket.P.map # atom-specific affinity map
map 1fkb_pocket.I.map # atom-specific affinity map
elecmap 1fkb_pocket.e.map # electrostatic potential map
dsolvmap 1fkb_pocket.d.map              # desolvation potential map
move 1fkb_ligand.pdbqt
## EVALUATE LIGAND ENERGY in RECEPTOR SECTION
epdb                                 # small molecule to be evaluated

## AUTODOCK_SCORE -12.70 
